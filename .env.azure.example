# Copy to .env.azure.local and replace these values with YOUR existing resources.
# Read by scripts/docker-azure.mjs. Never put an API key or access token here.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://YOUR-DOCUMENT-RESOURCE.cognitiveservices.azure.com/
AZURE_OPENAI_ENDPOINT=https://YOUR-OPENAI-RESOURCE.openai.azure.com/
# Deployment name in Azure, not necessarily the underlying model name.
AZURE_OPENAI_DEPLOYMENT=YOUR-CHAT-DEPLOYMENT
