# Set true for standalone public demo (no API or login); false for Docker platform.
NEXT_PUBLIC_DEMO_MODE=false
# Browser OAuth/OIDC (Keycloak)
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=credit-intelligence
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=credit-intelligence-web
# Server-only Java endpoint; use http://credit-api:8080 inside Docker.
CREDIT_API_URL=http://localhost:8081

# Java case store (configure on the Java API service, not the browser app).
# Keep this database separate from Keycloak's authentication database.
CASE_DATABASE_URL=jdbc:postgresql://localhost:5433/credit_cases
CASE_DATABASE_USER=credit_app
CASE_DATABASE_PASSWORD=replace-with-a-secret
CASE_PERSISTENCE_ENABLED=true
CASE_WRITES_ENABLED=true
OCR_ENABLED=true
DOCUMENT_ANALYSIS_MODE=local
# Set mode to azure or azure-with-local-fallback only after granting the Java identity
# the Cognitive Services User role on this resource.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://YOUR-DOCUMENT-INTELLIGENCE.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-layout
# F0 returns at most two pages; the API rejects longer PDFs before upload.
AZURE_DOCUMENT_INTELLIGENCE_MAX_PAGES=2

# Azure OpenAI with workload identity; no API key is required.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Java-only bounded safety estimates, not billed Azure tokens or a EUR cost cap.
# Defaults stay conservative; docker-compose.azure.yml uses the local test profile.
AI_REQUESTS_PER_MINUTE=6
AI_TENANT_REQUESTS_PER_MINUTE=60
AI_DAILY_ACCOUNT_BUDGET=30000
AI_DAILY_TENANT_BUDGET=100000
