# AI-103 contractor pre-check – OPTIONAL Azure configuration (template, no secrets).
#
# Copy to the git-ignored private folder and fill in EXISTING resources only:
#   cp labs/ai103/azure.env.example .local/ai103-azure.env
#   (cd labs/ai103 && python3 -m contractor_lab cloud-plan --env-file ../../.local/ai103-azure.env)
#
# Nothing here creates resources. `cloud-plan` reads this file and makes no network call.
# Billable calls stay disabled until BOTH lines below are set on purpose.
AI103_AZURE_OPT_IN=
# Comma-separated subset of: search,speech,translator,voice-live,content-understanding,document-intelligence,foundry-agent,openai,content-safety,language,vision,app-insights
AI103_AZURE_SERVICES=

# Authentication: Microsoft Entra ID via `az login` (developer) or managed identity. Leave key variables unset.
# Roles to request per resource (Access control (IAM)): Search Index Data Reader, Cognitive Services User,
# Cognitive Services OpenAI User, Azure AI User (Foundry project). Never subscription-wide Owner.

# 1 · Evidence search (local: Qdrant + BM25). api-version 2026-04-01 is the latest GA version listed on 2026-11-11.
AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH.search.windows.net
AZURE_SEARCH_INDEX=ai103-contractor-dossier-index
AZURE_SEARCH_API_VERSION=2026-04-01

# 1 · Extraction (local: Docling) and 6 · Content Understanding (prebuilt analyzer names as documented)
AZURE_CONTENT_UNDERSTANDING_ENDPOINT=https://YOUR-AI-SERVICES.services.ai.azure.com/
AZURE_CONTENT_UNDERSTANDING_ANALYZER=prebuilt-documentSearch
AZURE_CONTENT_UNDERSTANDING_API_VERSION=2025-11-01

# 1 · Extraction alternative (the Java API already supports this one in Azure mode). 2024-11-30 is the GA version listed.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://YOUR-DOCUMENT-RESOURCE.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-layout
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30

# 2a · Read-only agent (local: Python agent, scripted or Ollama planner)
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=https://YOUR-AI-SERVICES.services.ai.azure.com/api/projects/YOUR-PROJECT
AZURE_AI_AGENT_MODEL_DEPLOYMENT=YOUR-CHAT-DEPLOYMENT

# 2b · Summary and email draft (local: Nova on Ollama). Resource-root endpoint, not /openai/v1.
AZURE_OPENAI_ENDPOINT=https://YOUR-OPENAI-RESOURCE.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=YOUR-CHAT-DEPLOYMENT

# 2c · Embedded instruction check (local: EvidenceGuard rules). Prompt Shields: POST {endpoint}/contentsafety/text:shieldPrompt
AZURE_CONTENT_SAFETY_ENDPOINT=https://YOUR-CONTENT-SAFETY.cognitiveservices.azure.com/
AZURE_CONTENT_SAFETY_API_VERSION=2024-09-01

# 2d · Email classification and PII (local: rules + regex masking). PII analyze-text, GA version listed on 2026-11-11.
AZURE_LANGUAGE_ENDPOINT=https://YOUR-LANGUAGE.cognitiveservices.azure.com/
AZURE_LANGUAGE_CLASSIFICATION_PROJECT=
AZURE_LANGUAGE_API_VERSION=2026-05-01

# 2e · Photo analysis (local: Tesseract OCR). Image Analysis 4.0 has no inpainting; the API retires on 2028-09-25.
AZURE_VISION_ENDPOINT=https://YOUR-VISION.cognitiveservices.azure.com/
AZURE_VISION_API_VERSION=2024-02-01

# 2f · Speech to text and text to speech (local: reference transcript of the synthetic site note; macOS voice).
# Fast transcription: {endpoint}/speechtotext/transcriptions:transcribe. Text to speech: https://{region}.tts.speech.microsoft.com
AZURE_SPEECH_ENDPOINT=https://YOUR-SPEECH.cognitiveservices.azure.com
AZURE_SPEECH_REGION=YOUR-REGION
AZURE_SPEECH_API_VERSION=2025-10-15

# 4 · Translator (local: English reference of the fictional e-mail). The regional value is required for a
# regional or multi-service resource; leave it empty only for a global resource.
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_API_VERSION=3.0

# 4 · Voice Live (local: scripted events). Reference api-version 2026-07-15; the quickstart uses 2026-04-10.
AZURE_VOICELIVE_ENDPOINT=https://YOUR-AI-SERVICES.services.ai.azure.com
AZURE_VOICELIVE_MODEL=YOUR-VOICE-LIVE-MODEL
AZURE_VOICELIVE_API_VERSION=2026-07-15

# 2g · Traces (local: OpenTelemetry collector → .local/ai103/otel/traces.jsonl)
# Used only with docker-compose.monitoring.yml after reviewing destination and retention.
APPLICATIONINSIGHTS_CONNECTION_STRING=
